{
  "datasets": [
    {
      "name": "4b06851a",
      "displayName": "Monthly Summary",
      "queryLines": [
        "SELECT\r\n",
        "    month_date,\r\n",
        "    month,\r\n",
        "    year,\r\n",
        "    total_income,\r\n",
        "    total_expense,\r\n",
        "    savings,\r\n",
        "    savings_percentage,\r\n",
        "    income_transaction_count,\r\n",
        "    expense_transaction_count,\r\n",
        "    average_expense\r\n",
        "FROM personal.finance.gold_monthly_summary\r\n",
        "ORDER BY month_date"
      ],
      "columns": [
        {
          "displayName": "Savings Rate",
          "description": "",
          "expression": "try_divide(SUM(savings), SUM(total_income))"
        }
      ]
    },
    {
      "name": "811353cd",
      "displayName": "Overall KPIs",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(total_income) AS total_income,\r\n",
        "    SUM(total_expense) AS total_expense,\r\n",
        "    SUM(savings) AS total_savings,\r\n",
        "    ROUND(\r\n",
        "        SUM(savings) / NULLIF(SUM(total_income), 0),\r\n",
        "        4\r\n",
        "    ) AS savings_rate\r\n",
        "FROM personal.finance.gold_monthly_summary"
      ]
    },
    {
      "name": "a8d9fddb",
      "displayName": "gold_category_overall",
      "config": {
        "version": "1.1",
        "source": "personal.finance.gold_category_overall",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "d30f93ba",
      "displayName": "Top 5 Expense Categories",
      "queryLines": [
        "WITH ranked AS (\r\n",
        "\r\n",
        "    SELECT\r\n",
        "        year,\r\n",
        "        category,\r\n",
        "        total_expense,\r\n",
        "\r\n",
        "        ROW_NUMBER() OVER (\r\n",
        "            PARTITION BY year\r\n",
        "            ORDER BY total_expense DESC\r\n",
        "        ) AS rank\r\n",
        "\r\n",
        "    FROM personal.finance.gold_category_yearly\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    year,\r\n",
        "    category,\r\n",
        "    total_expense\r\n",
        "\r\n",
        "FROM ranked\r\n",
        "\r\n",
        "WHERE rank <= 5\r\n",
        "\r\n",
        "ORDER BY\r\n",
        "    year,\r\n",
        "    total_expense DESC"
      ]
    },
